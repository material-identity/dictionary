      "accessCategory": "public",
      "granularity": "item",
      "condition": {
        "en": "Mandatory where the passport is established at item level (e.g. individually numbered coils).",
        "de": "Verpflichtend, wenn der Pass auf Artikelebene erstellt wird (z. B. einzeln nummerierte Coils)."
      }
    },
